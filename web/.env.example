# ---------- Core ----------
# Local dev = SQLite (zero setup). Production = PostgreSQL; see DEPLOYMENT.md
# (npm run db:gen:prod → prisma db push --schema prisma/schema.prod.prisma).
# Local:      DATABASE_URL="file:./dev.db"
# Production:  DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# Absolute base URL of the site (no trailing slash). On Render, the app falls
# back to RENDER_EXTERNAL_URL automatically; set this when adding a custom domain.
APP_BASE_URL="http://localhost:3000"

# [BRAND_NAME] placeholder — set your real brand before launch.
NEXT_PUBLIC_BRAND_NAME="Luminary"
NEXT_PUBLIC_BRAND_NAME_ZH="明鉴"
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_LEGAL_JURISDICTION=""

# ---------- Auth (Auth.js / NextAuth v5) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required behind Render's reverse proxy.
AUTH_TRUST_HOST="true"
# Comma- or newline-separated personal tokens. Each token is a separate account
# with its own profiles and unlimited interpretations. Use 20+ random characters
# per person and never share one token between people.
ACCESS_ACCOUNT_TOKENS=""
# Legacy single-token fallback (also becomes one account).
UNLIMITED_ACCESS_CODE=""
# Email sign-in through Resend's HTTPS API. Leave RESEND_API_KEY empty in
# development: magic links are printed and exposed at /api/dev/magic-link.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com" # must use a domain verified in Resend
# Google OAuth (optional — button appears only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- DeepSeek interpretation (interpretation-only, md §4) ----------
# Without a key the app runs in clearly-labeled sample mode.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_TIMEOUT_MS="45000"
DEEPSEEK_MAX_RETRIES="2"

# ---------- Stripe (md §7/§9/§11/§14) ----------
# Obtain WRITTEN Stripe approval for this business category before launch —
# psychic services/fortune telling are prohibited in some jurisdictions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""   # stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_TAX_ENABLED="0"     # set 1 after enabling Stripe Tax (Phase 1 requirement for EU/UK sales)
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=""  # ASCII only, recognizable (md §11)

# Dev-only simulated payments (never active in production builds):
DEV_FAKE_PAYMENTS="1"
