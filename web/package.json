{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "render:build": "npm run db:gen:prod && prisma generate --schema prisma/schema.prod.prisma && next build --webpack",
    "render:start": "npm run db:push:prod && npm run db:seed && npm run db:cities && npm start",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:engines": "tsx scripts/verify-engines.ts",
    "db:cities": "tsx scripts/import-cities.ts",
    "verify:routes": "tsx scripts/verify-routes.ts",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.prod.prisma --skip-generate",
    "db:gen:prod": "node scripts/gen-prisma-prod.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tailwindcss/postcss": "^4.3.3",
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "lunar-javascript": "^1.7.7",
    "luxon": "^3.7.2",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pinyin-pro": "^3.28.2",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.34.5": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
